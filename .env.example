# ─────────────────────────────────────────────────────────────────────────────
# AIDA — biến môi trường
#
# Sao chép thành `.env.local` cho máy cá nhân. Trên Vercel (web + API) và
# Railway (worker) thì đặt trong dashboard của từng nơi; cột "Nơi cần" ghi rõ
# chỗ nào bắt buộc có.
#
# Không bao giờ đặt tiền tố NEXT_PUBLIC_ cho một khoá bí mật: mọi biến
# NEXT_PUBLIC_ đều được nhúng vào bundle trình duyệt.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase ─────────────────────────────── Nơi cần: Vercel + Railway + local
# Dự án cloud, hoặc `supabase start` cho stack local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ phía server. Bỏ qua RLS — rò rỉ khoá này là rò rỉ toàn bộ dữ liệu.
SUPABASE_SERVICE_ROLE_KEY=
# Worker Railway đọc URL qua tên này (không có tiền tố NEXT_PUBLIC_).
SUPABASE_URL=
# Chuỗi kết nối Postgres trực tiếp. Chỉ dùng cho `npm run test:sql` và
# `npm run check:migrations`; trỏ vào database KIỂM THỬ, không phải production.
SUPABASE_DB_URL=

# ── Mô hình AI ───────────────────────────── Nơi cần: Vercel + Railway
# Gemini: sinh kịch bản, kiểm tra chất lượng, đọc thoại (TTS).
GEMINI_API_KEY=
# Bí danh của GEMINI_API_KEY cho vài SDK Google. Đặt cùng giá trị nếu cần.
GOOGLE_API_KEY=
# OpenAI: tuỳ chọn. Có khoá thì ảnh có chữ tiếng Việt được vẽ bằng gpt-image-2.
OPENAI_API_KEY=
# Ghi đè model sinh văn bản. Trống = mặc định trong src/lib/ai-models.ts.
CREATIVE_TEXT_MODEL=
# Model riêng cho phim gia đình (kịch bản dài, cần model mạnh hơn).
FAMILY_CREATIVE_TEXT_MODEL=

# ── WaveSpeed (video) ────────────────────── Nơi cần: Vercel + Railway
WAVESPEED_API_KEY=
# Bí mật ký webhook. Thiếu là mọi callback bị từ chối 401.
WAVESPEED_WEBHOOK_SECRET=

# ── Worker và cron ───────────────────────── Nơi cần: Vercel + Railway
# Chuỗi ngẫu nhiên dài (`openssl rand -hex 32`). Bảo vệ /api/internal/*.
VIDEO_WORKER_TOKEN=
# Vercel tự gắn vào cron. Đặt cùng chỗ để gọi tay khi diễn tập sự cố.
CRON_SECRET=
# Worker gọi ngược về app. Entrypoint Railway tự đặt thành http://127.0.0.1:$PORT.
AIDA_BASE_URL=
# URL công khai dùng trong link gửi ra ngoài (email, webhook provider).
AIDA_PUBLIC_BASE_URL=
# Nơi xử lý watermark nếu tách khỏi app chính. Trống = dùng AIDA_BASE_URL.
WATERMARK_PROCESSOR_URL=

# ── Thanh toán SePay ─────────────────────── Nơi cần: Vercel
SEPAY_WEBHOOK_API_KEY=
SEPAY_BANK_ACCOUNT=
SEPAY_BANK_NAME=
SEPAY_BANK_BIN=
SEPAY_BANK_VA=
SEPAY_ACCOUNT_NAME=

# ── Quan sát và cảnh báo ─────────────────── Nơi cần: Vercel + Railway
# DSN Sentry dạng https://<key>@<host>/<project>. Trống thì lỗi chỉ vào log.
SENTRY_DSN=
# Ghi đè tên môi trường trong Sentry. Trống = VERCEL_ENV hoặc NODE_ENV.
SENTRY_ENVIRONMENT=
# Bot Telegram nhận cảnh báo từ /api/cron/alerts. Trống thì cảnh báo chỉ vào log.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=

# ── Web ──────────────────────────────────── Nơi cần: Vercel
# Dùng cho metadata, sitemap và link tuyệt đối.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=

# ── Cờ tính năng ─────────────────────────── Nơi cần: Vercel + Railway
# Khoá giọng cố định cho một số dự án (canary). Danh sách id, phân tách bằng dấu phẩy.
SHORT_FILM_FIXED_VOICE_ENABLED=
SHORT_FILM_FIXED_VOICE_PROJECT_IDS=
