# Supabase — dự án local (supabase start) hoặc dự án cloud
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chỉ dùng phía server. Tuyệt đối không đặt tiền tố NEXT_PUBLIC_ cho key này.
SUPABASE_SERVICE_ROLE_KEY=

# Google Gemini — dùng cho sinh nội dung và sinh ảnh (server-side only)
GEMINI_API_KEY=

# OpenAI — tuỳ chọn. Có key thì meme có chữ được vẽ bằng gpt-image-2 (chữ tiếng
# Việt sắc nét hơn); không có thì mọi thứ chạy Gemini như cũ.
OPENAI_API_KEY=
